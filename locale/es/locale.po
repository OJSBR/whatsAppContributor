msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Plugin WhatsApp para colaboradores"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Añade un campo de teléfono/WhatsApp (formato E.164) al formulario de contribuyente (autor). Configurable como opcional u obligatorio por revista."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Teléfono / WhatsApp"


msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Use el formato E.164: + seguido del código de país y el número, sin espacios ni guiones. Ejemplo: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Defina si el campo Teléfono / WhatsApp es obligatorio al registrar un contribuyente para un artículo en esta revista."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Hacer obligatorio el campo Teléfono / WhatsApp para todos los contribuyentes."

msgid "plugins.generic.whatsAppContributor.settings.showOnRegistration.label"
msgstr "Solicitar también el Teléfono / WhatsApp en el formulario de registro de usuario. El número se guarda como teléfono de la cuenta y se completa automáticamente cuando el usuario pasa a ser autor de su propio envío."

msgid "plugins.generic.whatsAppContributor.settings.showOnContributor.label"
msgstr "Pedir el número al registrar un autor o coautor"

msgid "plugins.generic.whatsAppContributor.field.example"
msgstr "+34 612 345 678"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Formato internacional, comenzando con + y el código del país. Ejemplo: {$example}. Se usa solo para el contacto de los editores de la revista; no se publica."
