#, fuzzy
msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Zásuvný modul WhatsApp pro přispěvatele"

#, fuzzy
msgid "plugins.generic.whatsAppContributor.description"
msgstr "Přidává do formuláře přispěvatele (autora) pole telefon/WhatsApp ve formátu E.164. Lze je nastavit jako volitelné, nebo povinné pro každý časopis. Vyvinuto OJSBR (https://ojsbr.com.br)."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telefon / WhatsApp"

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.description"
