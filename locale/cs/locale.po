#, fuzzy
msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Nastavte, zda je pole Telefon / WhatsApp povinné při zadávání přispěvatele k článku v tomto časopise."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Nastavit pole Telefon / WhatsApp jako povinné pro všechny přispěvatele."
