#, fuzzy
msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Wtyczka WhatsApp dla współtwórców"

#, fuzzy
msgid "plugins.generic.whatsAppContributor.description"
msgstr "Dodaje pole telefon/WhatsApp (format E.164) do formularza współtwórcy (autora). Można je ustawić jako opcjonalne lub wymagane w każdym czasopiśmie. Opracowane przez OJSBR (https://ojsbr.com.br)."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telefon / WhatsApp"

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Międzynarodowy numer telefonu w formacie E.164, zaczynający się od + i numeru kierunkowego kraju. Przykład: +5511999999999. Numer posłuży wyłącznie do kontaktu ze strony redakcji i nie będzie publikowany."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
