msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Plugin Telefone/WhatsApp do Contribuidor"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Adiciona um campo Telefone/WhatsApp (formato E.164) ao formulário de cadastro de contribuidor do artigo. Configurável como opcional ou obrigatório por revista. Desenvolvido pela OJSBR (https://ojsbr.com.br)."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telefone / WhatsApp"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Número de telefone internacional no formato E.164, começando com + e código do país. Exemplo: +5511999999999. Este número será usado apenas para contato pelos editores da revista e não será divulgado publicamente."

msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Use o formato E.164: + seguido do código do país e número, sem espaços ou traços. Exemplo: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Defina se o campo Telefone/WhatsApp é obrigatório no cadastro de contribuidores de artigos desta revista."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Tornar o campo Telefone/WhatsApp obrigatório para todos os contribuidores."
