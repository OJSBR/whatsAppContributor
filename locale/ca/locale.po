msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Connector WhatsApp per a col·laboradors"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Afegeix un camp de telèfon/WhatsApp (format E.164) al formulari de col·laborador (autor). Es pot configurar com a opcional o obligatori per a cada revista. Desenvolupat per OJSBR (https://ojsbr.com.br)."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telèfon / WhatsApp"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Número de telèfon internacional en format E.164, començant per + i el codi de país. Exemple: +5511999999999. Aquest número només s'utilitzarà per al contacte per part de l'equip editorial i no es farà públic."

msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Utilitzeu el format E.164: + seguit del codi de país i el número, sense espais ni guions. Exemple: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Definiu si el camp Telèfon / WhatsApp és obligatori en registrar un col·laborador per a un article d'aquesta revista."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Fes que el camp Telèfon / WhatsApp sigui obligatori per a tots els col·laboradors."
