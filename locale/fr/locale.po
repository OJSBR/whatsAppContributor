msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Plugin WhatsApp pour les contributeurs"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Ajoute un champ téléphone/WhatsApp (format E.164) au formulaire de contributeur (auteur). Configurable comme facultatif ou obligatoire selon la revue. Développé par OJSBR (https://ojsbr.com.br)."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Téléphone / WhatsApp"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Numéro de téléphone international au format E.164, commençant par + et l'indicatif du pays. Exemple : +5511999999999. Ce numéro sera utilisé uniquement pour le contact par les rédacteurs de la revue et ne sera pas divulgué publiquement."

msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Utilisez le format E.164 : + suivi de l'indicatif du pays et du numéro, sans espaces ni tirets. Exemple : +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Définissez si le champ Téléphone / WhatsApp est obligatoire lors de l'enregistrement d'un contributeur pour un article dans cette revue."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Rendre le champ Téléphone / WhatsApp obligatoire pour tous les contributeurs."
