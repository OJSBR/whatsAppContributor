msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Complemento WhatsApp para colaboradores"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Engade un campo de teléfono/WhatsApp (formato E.164) ao formulario de colaborador (autoría). Pódese configurar como opcional ou obrigatorio en cada revista. Desenvolvido por OJSBR (https://ojsbr.com.br)."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Teléfono / WhatsApp"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Número de teléfono internacional en formato E.164, comezando por + e o código de país. Exemplo: +5511999999999. Este número só se empregará para o contacto por parte do persoal editor e non se fará público."

msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Empregue o formato E.164: + seguido do código de país e o número, sen espazos nin guións. Exemplo: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Defina se o campo Teléfono / WhatsApp é obrigatorio ao rexistrar unha persoa colaboradora nun artigo desta revista."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Facer obrigatorio o campo Teléfono / WhatsApp para todas as persoas colaboradoras."
