#, fuzzy
msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Приставка WhatsApp за сътрудници"

#, fuzzy
msgid "plugins.generic.whatsAppContributor.description"
msgstr "Добавя поле телефон/WhatsApp (формат E.164) към формуляра за сътрудник (автор). Може да се настрои като незадължително или задължително за всяко списание. Разработено от OJSBR (https://ojsbr.com.br)."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Телефон / WhatsApp"

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Международен телефонен номер във формат E.164, започващ с + и код на държавата. Пример: +5511999999999. Този номер ще се използва само за връзка от редакторите на списанието и няма да бъде публично оповестен."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Използвайте формат E.164: + следван от код на държавата и номера, без интервали и тирета. Пример: +5511999999999."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Задайте дали полето Телефон / WhatsApp е задължително при регистриране на сътрудник към статия в това списание."

#, fuzzy
msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Полето Телефон / WhatsApp да е задължително за всички сътрудници."
