msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Plugin WhatsApp per i collaboratori"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Aggiunge un campo telefono/WhatsApp (formato E.164) al modulo del collaboratore (autore). Configurabile come facoltativo o obbligatorio per ciascuna rivista."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telefono / WhatsApp"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Numero di telefono internazionale in formato E.164, che inizia con + e il prefisso del paese. Esempio: +5511999999999. Questo numero sarà usato solo per il contatto da parte dei redattori della rivista e non sarà divulgato pubblicamente."

msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Usa il formato E.164: + seguito dal prefisso del paese e dal numero, senza spazi o trattini. Esempio: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Stabilisci se il campo Telefono / WhatsApp è obbligatorio durante la registrazione di un collaboratore per un articolo in questa rivista."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Rendere obbligatorio il campo Telefono / WhatsApp per tutti i collaboratori."

msgid "plugins.generic.whatsAppContributor.settings.showOnRegistration.label"
msgstr "Chiedere anche il Telefono / WhatsApp nel modulo di registrazione utente. Il numero viene salvato come telefono dell'account e compilato automaticamente quando l'utente diventa autore della propria proposta."
