msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "Plugin Telefone/WhatsApp do Contribuidor"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Adiciona um campo Telefone/WhatsApp (formato E.164) ao formulário de registo de contribuidor do artigo. Configurável como opcional ou obrigatório por revista."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telefone / WhatsApp"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Número de telefone internacional no formato E.164, começando por + e o indicativo do país. Exemplo: +351210000000. Este número será utilizado apenas para contacto pelos editores da revista e não será divulgado publicamente."

msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Utilize o formato E.164: + seguido do indicativo do país e do número, sem espaços nem traços. Exemplo: +351210000000."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Defina se o campo Telefone/WhatsApp é obrigatório no registo de contribuidores de artigos desta revista."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Tornar o campo Telefone/WhatsApp obrigatório para todos os contribuidores."

msgid "plugins.generic.whatsAppContributor.settings.showOnRegistration.label"
msgstr "Pedir também o Telefone / WhatsApp no formulário de registo de utilizador. O número fica guardado como telefone da conta e é preenchido automaticamente quando o utilizador passa a autor da sua própria submissão."

msgid "plugins.generic.whatsAppContributor.settings.showOnContributor.label"
msgstr "Pedir o número no registo de autor ou coautor"
