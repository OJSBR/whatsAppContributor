msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "WhatsApp-bijdragerplug-in"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Voegt een telefoon-/WhatsApp-veld (E.164-notatie) toe aan het formulier voor bijdragers (auteurs). Per tijdschrift in te stellen als optioneel of verplicht."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Telefoon / WhatsApp"


msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Gebruik de E.164-notatie: + gevolgd door landcode en nummer, zonder spaties of streepjes. Voorbeeld: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Bepaal of het veld Telefoon / WhatsApp verplicht is bij het registreren van een bijdrager voor een artikel in dit tijdschrift."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Maak het veld Telefoon / WhatsApp verplicht voor alle bijdragers."

msgid "plugins.generic.whatsAppContributor.settings.showOnRegistration.label"
msgstr "Vraag ook naar Telefoon / WhatsApp op het registratieformulier. Het nummer wordt opgeslagen als telefoonnummer van het account en automatisch ingevuld wanneer de gebruiker auteur wordt van de eigen inzending."

msgid "plugins.generic.whatsAppContributor.settings.showOnContributor.label"
msgstr "Het nummer vragen bij het vastleggen van een auteur of co-auteur"

msgid "plugins.generic.whatsAppContributor.field.example"
msgstr "+31 6 12345678"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "Internationaal formaat, beginnend met + en het landnummer. Voorbeeld: {$example}. Alleen voor contact door de redactie; het wordt niet gepubliceerd."
