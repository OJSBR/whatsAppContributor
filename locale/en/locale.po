msgid "plugins.generic.whatsAppContributor.displayName"
msgstr "WhatsApp Contributor Plugin"

msgid "plugins.generic.whatsAppContributor.description"
msgstr "Adds a phone/WhatsApp field (E.164 format) to the contributor (author) form. Configurable as optional or required per journal."

msgid "plugins.generic.whatsAppContributor.field.label"
msgstr "Phone / WhatsApp"


msgid "plugins.generic.whatsAppContributor.field.invalidFormat"
msgstr "Use E.164 format: + followed by country code and number, no spaces or hyphens. Example: +5511999999999."

msgid "plugins.generic.whatsAppContributor.settings.description"
msgstr "Set whether the Phone / WhatsApp field is required when registering a contributor for an article in this journal."

msgid "plugins.generic.whatsAppContributor.settings.required.label"
msgstr "Make the Phone / WhatsApp field required for all contributors."

msgid "plugins.generic.whatsAppContributor.settings.showOnRegistration.label"
msgstr "Also ask for the Phone / WhatsApp on the user registration form. The number is saved as the phone of the account and filled in automatically when the user becomes an author of their own submission."

msgid "plugins.generic.whatsAppContributor.settings.showOnContributor.label"
msgstr "Ask for the number when an author or co-author is recorded"

msgid "plugins.generic.whatsAppContributor.field.example"
msgstr "+1 555 123 4567"

msgid "plugins.generic.whatsAppContributor.field.description"
msgstr "International format, starting with + and the country code. Example: {$example}. Used only for contact by the journal's editors; it is never published."
